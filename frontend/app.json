{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.bodyprogress.iv70xj",
      "infoPlist": {
        "NSCameraUsageDescription": "Tirar fotos de evolução dos alunos",
        "NSPhotoLibraryUsageDescription": "Enviar fotos de evolução dos alunos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.bodyprogress.iv70xj",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Enviar fotos de evolução dos alunos",
          "cameraPermission": "Tirar fotos de evolução dos alunos"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}